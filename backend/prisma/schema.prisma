generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users / Hotel Staff ──────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin") // "admin" | "staff"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hotels Hotel[]
}

// ── Hotels ────────────────────────────────────────────

model Hotel {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  website   String?
  timezone  String   @default("Europe/Oslo")
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Per-hotel SMTP for sending welcome emails. If null, platform default is used.
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPass     String?  // TODO: encrypt at rest before going public
  smtpFromName String?
  smtpFromEmail String?

  // Facility flags captured during onboarding wizard
  hasRestaurant   Boolean @default(false)
  hasRoomService  Boolean @default(false)
  hasSpa          Boolean @default(false)
  hasPool         Boolean @default(false)
  hasGym          Boolean @default(false)
  hasBar          Boolean @default(false)
  hasConference   Boolean @default(false)
  hasTransfers    Boolean @default(false)
  petFriendly     Boolean @default(false)

  // The concierge's *human* name as guests will see it. The guest concierge
  // ALWAYS behaves as this human and never reveals it's an AI.
  conciergeName String @default("Alfred Pennyworth")

  // Room-service bookability is now derived from whether an Integration is
  // linked: roomServiceIntegrationId != null → room service is bookable
  // through that integration; null → informational only.
  roomServiceIntegrationId String?
  roomServiceIntegration   Integration? @relation("HotelRoomServiceIntegration", fields: [roomServiceIntegrationId], references: [id], onDelete: SetNull)
  // Free-form notes shown to the concierge about HOW room-service orders
  // are fulfilled (e.g. "Printed in main kitchen at the pass"). Surfaced in
  // the bot context only, never to guests verbatim.
  roomServiceBookingNotes String?

  // Structured details for the simpler facilities (knowledge-style fields
  // displayed on the Facilities tab and pulled into the concierge context)
  spaHours         String?
  spaNotes         String?
  poolHours        String?
  poolNotes        String?
  gymHours         String?
  gymNotes         String?
  barHours         String?
  barNotes         String?
  conferenceNotes  String?
  petPolicy        String?
  transferNotes    String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  knowledgeEntries   KnowledgeEntry[]
  menuItems          MenuItem[]
  services           Service[]
  bookings           Booking[]
  telegramBot        TelegramBot?
  openclawConfig     OpenClawConfig?
  venues             Venue[]
  integrations       Integration[]

  @@map("hotels")
}

// ── Integrations (how bookings actually flow to the hotel's systems) ──
//
// One Integration represents a single configured booking pipe (e.g. a
// specific OpenTable account, a Spa-Booker tenant, a webhook URL, or the
// platform's internal pending-bookings queue). Offerings (venues and
// services) and the hotel-level room-service flow each reference at most
// one Integration via a foreign key. "bookable" is therefore a *computed*
// property: an offering is bookable iff it has an integrationId set AND the
// linked integration is not in error state.

model Integration {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  // Human-readable label, shown in the dashboard dropdown ("OpenTable —
  // main building", "Spa-Booker Pro", "Zapier webhook").
  name      String
  // Kind drives form rendering, validation, and runtime booking behaviour.
  //   manual_queue     — internal pending-bookings queue (no external system)
  //   custom_webhook   — POST booking JSON to a URL with optional auth header
  //   email            — booking is emailed to a hotel address
  //   opentable        — OpenTable account (stub for v1, real impl later)
  //   google_calendar  — Google Calendar (stub for v1, real impl later)
  kind      String

  // Free-form endpoint identifier (URL for webhook, calendar id for gcal,
  // restaurant id for OpenTable, etc.). May be null for kinds that don't
  // need one (manual_queue).
  endpoint  String?

  // Encrypted blob of secret credentials. Format: "v1:<base64-iv>:<base64-ciphertext>".
  // Decrypted only at request time; never sent back to the frontend
  // verbatim. Plaintext shape is provider-specific JSON.
  authBlob  String?

  // Last test result. Updated whenever the user hits "Test connection" or
  // when a real booking is attempted.
  status        String   @default("untested") // "untested" | "ok" | "error"
  lastTestedAt  DateTime?
  lastError     String?

  // Reverse relations — needed because Hotel/Venue/Service can each reference
  // this Integration and Prisma requires the opposite side of every relation.
  venues                 Venue[]
  services               Service[]
  hotelsAsRoomService    Hotel[]   @relation("HotelRoomServiceIntegration")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId])
  @@map("integrations")
}

// ── Hotel Knowledge Base (free-text) ──────────────────

model KnowledgeEntry {
  id       String @id @default(cuid())
  category String // "amenities" | "policies" | "local_area" | "general"
  content  String

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("knowledge_entries")
}

// ── Venues (restaurants, bars, lounges, room-service kitchen, etc.) ───

model Venue {
  id          String  @id @default(cuid())
  name        String  // "Main Restaurant", "Sky Bar", "Lobby Café", "Room Service"
  kind        String  @default("restaurant") // "restaurant" | "bar" | "lounge" | "room_service" | "cafe"
  description String?
  hours       String? // "17:00-22:00" or freeform
  location    String? // "Lobby level", "12th floor"
  active      Boolean @default(true)

  // ── Bookability ────────────────────────────────────
  // bookable status is computed from integrationId: when an Integration is
  // linked and not in error state, the concierge may take reservations and
  // route them through that integration. Otherwise the venue is
  // informational only and the concierge must redirect the guest to a human.
  integrationId      String?
  integration        Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  // Free-text fulfilment notes — surfaced to the concierge context for
  // bookable venues so it knows e.g. "All Sky Bar tables are walk-in only
  // after 21:00". Not shown verbatim to guests.
  bookingInstructions String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotelId String
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  menuItems MenuItem[]

  @@map("venues")
}

// ── Menu Items ────────────────────────────────────────────

model MenuItem {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Int     // price in cents/NOK øre
  category    String  // "mains" | "starters" | "desserts" | "drinks" | etc.
  available   Boolean @default(true)
  // Whether this item can also be ordered to the room
  availableForRoomService Boolean @default(true)

  hotelId String
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@map("menu_items")
}

// ── Hotel Services (spa, transfers, etc.) ─────────────

model Service {
  id          String  @id @default(cuid())
  name        String
  description String?
  durationMin Int?
  price       Int?    // cents/NOK øre
  // Category groups services for the dashboard:
  //   "spa_treatment" | "spa_access" | "transfer" | "activity" | "general"
  category    String  @default("general")

  // ── Bookability ────────────────────────────────────
  // Bookable iff an Integration is linked and not in error state.
  integrationId      String?
  integration        Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  bookingInstructions String?

  hotelId String
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("services")
}

// ── Bookings (table reservations & room service) ──────

model Booking {
  id            String   @id @default(cuid())
  type          String   // "table" | "room_service"
  guestName     String
  guestRoom     String?
  details       String   // e.g. "Table for 2, 20:00" or "Salmon, Sauvignon Blanc"
  status        String   @default("pending") // "pending" | "confirmed" | "fulfilled" | "cancelled"
  calendarEventId String? // Google Calendar event ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hotelId String
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("bookings")
}

// ── Telegram Bot Config ───────────────────────────────

model TelegramBot {
  id          String  @id @default(cuid())
  botToken    String
  botUsername String
  webhookUrl  String?
  active      Boolean @default(true)

  // Manager-side deep link & staff bot username
  managerBotUsername String?
  managerDeepLink    String?
  staffToken         String?

  hotelId String @unique
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("telegram_bots")
}

// ── OpenClaw Agent Config ─────────────────────────────

model OpenClawConfig {
  id            String  @id @default(cuid())
  agentId       String
  workspacePath String
  soulContent  String? // The SOUL.md content for this hotel's agent
  active        Boolean @default(true)

  hotelId String @unique
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("openclaw_configs")
}
