generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users / Hotel Staff ──────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin") // "admin" | "staff"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hotels Hotel[]
}

// ── Hotels ────────────────────────────────────────────

model Hotel {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  website   String?
  timezone  String   @default("Europe/Oslo")
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Per-hotel SMTP for sending welcome emails. If null, platform default is used.
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPass     String?  // TODO: encrypt at rest before going public
  smtpFromName String?
  smtpFromEmail String?

  // Facility flags captured during onboarding wizard
  hasRestaurant   Boolean @default(false)
  hasRoomService  Boolean @default(false)
  hasSpa          Boolean @default(false)
  hasPool         Boolean @default(false)
  hasGym          Boolean @default(false)
  hasBar          Boolean @default(false)
  hasConference   Boolean @default(false)
  hasTransfers    Boolean @default(false)
  petFriendly     Boolean @default(false)

  // The concierge's *human* name as guests will see it. The guest concierge
  // ALWAYS behaves as this human and never reveals it's an AI.
  conciergeName String @default("Alfred Pennyworth")

  // Whether room-service orders are actually fulfillable end-to-end at this
  // hotel (kitchen + delivery wired up via the platform's pending-orders
  // workflow OR an external integration). When false, the concierge will
  // describe the menu but NEVER promise to deliver; it redirects to the
  // appropriate venue or the front desk.
  roomServiceBookable Boolean @default(false)
  // Optional notes shown to the concierge about HOW room-service bookings
  // are fulfilled (e.g. "Calls go to extension 9", "Orders printed in main
  // kitchen"). Surfaced in the bot context only, never to guests verbatim.
  roomServiceBookingNotes String?

  // Structured details for the simpler facilities (knowledge-style fields
  // displayed on the Facilities tab and pulled into the concierge context)
  spaHours         String?
  spaNotes         String?
  poolHours        String?
  poolNotes        String?
  gymHours         String?
  gymNotes         String?
  barHours         String?
  barNotes         String?
  conferenceNotes  String?
  petPolicy        String?
  transferNotes    String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  knowledgeEntries   KnowledgeEntry[]
  menuItems          MenuItem[]
  services           Service[]
  bookings           Booking[]
  telegramBot        TelegramBot?
  openclawConfig     OpenClawConfig?
  venues             Venue[]

  @@map("hotels")
}

// ── Hotel Knowledge Base (free-text) ──────────────────

model KnowledgeEntry {
  id       String @id @default(cuid())
  category String // "amenities" | "policies" | "local_area" | "general"
  content  String

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("knowledge_entries")
}

// ── Venues (restaurants, bars, lounges, room-service kitchen, etc.) ───

model Venue {
  id          String  @id @default(cuid())
  name        String  // "Main Restaurant", "Sky Bar", "Lobby Café", "Room Service"
  kind        String  @default("restaurant") // "restaurant" | "bar" | "lounge" | "room_service" | "cafe"
  description String?
  hours       String? // "17:00-22:00" or freeform
  location    String? // "Lobby level", "12th floor"
  active      Boolean @default(true)

  // ── Bookability ────────────────────────────────────
  // bookable=true means the concierge can actually take a reservation
  // here end-to-end (staff will see it in the dashboard pending-bookings
  // queue, or an external integration will receive it). bookable=false
  // means the venue is INFORMATIONAL ONLY — the concierge can describe
  // it, share hours and menu, but MUST direct the guest to call the
  // venue, the front desk, or walk in. Default false (safer for new hotels).
  bookable           Boolean @default(false)
  // How bookings flow when bookable=true:
  //   "internal"   — POST /api/guest/bookings (pending queue)
  //   "calendar"   — Google Calendar / iCal integration (future)
  //   "external"   — third-party API like OpenTable (future)
  //   "manual"     — staff promises to follow up out-of-band; bot still records intent
  bookingMethod      String? // null when not bookable
  // Free-text instructions for the concierge or for staff. Shown to the
  // bot context (e.g. "All Sky Bar tables are walk-in only after 21:00")
  bookingInstructions String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotelId String
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  menuItems MenuItem[]

  @@map("venues")
}

// ── Menu Items ────────────────────────────────────────────

model MenuItem {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Int     // price in cents/NOK øre
  category    String  // "mains" | "starters" | "desserts" | "drinks" | etc.
  available   Boolean @default(true)
  // Whether this item can also be ordered to the room
  availableForRoomService Boolean @default(true)

  hotelId String
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@map("menu_items")
}

// ── Hotel Services (spa, transfers, etc.) ─────────────

model Service {
  id          String  @id @default(cuid())
  name        String
  description String?
  durationMin Int?
  price       Int?    // cents/NOK øre
  // Category groups services for the dashboard:
  //   "spa_treatment" | "spa_access" | "transfer" | "activity" | "general"
  category    String  @default("general")

  // ── Bookability ────────────────────────────────────
  // bookable=true → the concierge can actually book this service end-to-end
  // (e.g. spa appointment, airport transfer pickup). bookable=false → the
  // service is informational only; the bot describes it, prices it, but
  // MUST send the guest to a real human (front desk / spa reception / phone
  // number) to complete the booking. Default false.
  bookable           Boolean @default(false)
  bookingMethod      String? // "internal" | "calendar" | "external" | "manual"
  bookingInstructions String?

  hotelId String
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("services")
}

// ── Bookings (table reservations & room service) ──────

model Booking {
  id            String   @id @default(cuid())
  type          String   // "table" | "room_service"
  guestName     String
  guestRoom     String?
  details       String   // e.g. "Table for 2, 20:00" or "Salmon, Sauvignon Blanc"
  status        String   @default("pending") // "pending" | "confirmed" | "fulfilled" | "cancelled"
  calendarEventId String? // Google Calendar event ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hotelId String
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("bookings")
}

// ── Telegram Bot Config ───────────────────────────────

model TelegramBot {
  id          String  @id @default(cuid())
  botToken    String
  botUsername String
  webhookUrl  String?
  active      Boolean @default(true)

  // Manager-side deep link & staff bot username
  managerBotUsername String?
  managerDeepLink    String?
  staffToken         String?

  hotelId String @unique
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("telegram_bots")
}

// ── OpenClaw Agent Config ─────────────────────────────

model OpenClawConfig {
  id            String  @id @default(cuid())
  agentId       String
  workspacePath String
  soulContent  String? // The SOUL.md content for this hotel's agent
  active        Boolean @default(true)

  hotelId String @unique
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("openclaw_configs")
}
